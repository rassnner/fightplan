  "guidelines": [
    {
      "title": "Double Progression (DP)",
      "text": "Gewicht erst erhöhen, wenn du in allen Sätzen einer Übung die obere Wiederholungszahl sauber und explosiv schaffst (z. B. 7, 7, 7 bei 5–7 Wdh.). Immer 1–2 saubere Wiederholungen im Tank lassen (RIR 1–2) – im Defizit nie ans Muskelversagen."
    },
    {
      "title": "Gewichtssprünge",
      "text": "Oberkörper-Übungen +2,5 kg gesamt, Kniebeugen und Kreuzheben +2,5 bis 5 kg gesamt."
    },
    {
      "title": "Satzpausen",
      "text": "2,5–3 min bei schweren Grundübungen (Squats, Deadlift, Bankdrücken, Schrägbank, Rows, Klimmzüge), 90 s bei Assistenzübungen, 60–90 s zwischen Supersätzen."
    },
    {
      "title": "Deload-Woche",
      "text": "Alle 4–5 Wochen das Volumen bei Kraft und Ausdauer um 40–50 % senken (bei 2–3 Arbeitssätzen je 1 Satz streichen, Samstag-HIIT weglassen). Vereinstechnik locker weiterführen."
    },
    {
      "title": "Notbremse bei Überlastung",
      "text": "Sind die Beine zwei Freitage hintereinander beim Sparring bleiern oder steigt der morgendliche Ruhepuls dauerhaft um 5–7 bpm, zuerst das Leg-Extension/Leg-Curl-Superset (Mo) und die Donnerstags-Sprints streichen – niemals den Schlaf (8–9 h) oder die schweren Grundübungen."
    }
  ]
}
